# Copy this file to scripts/lightrag-service.local.env only when an override is
# needed. Do not put provider API keys in this file; keep those in .env.

# LIGHTRAG_CONDA_EXE=/Users/you/miniconda3/bin/conda
# LIGHTRAG_CONDA_ENV=lightrag-memory-eval

# The local Jina reranker helper can be supervised by lightrag-service. Replace
# the two absolute paths when this repository or Conda is located elsewhere.
# LIGHTRAG_RERANK_COMMAND='/Users/you/miniconda3/envs/lightrag-memory-eval/bin/python /path/to/LightRAG/scripts/local_reranker_service.py --host 127.0.0.1 --port 8000'
# LIGHTRAG_RERANK_PROCESS_MATCH='local_reranker_service.py'
